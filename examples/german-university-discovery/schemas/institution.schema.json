{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InstitutionEntry",
  "description": "An institution to sweep for research groups. One entry per university or research institute.",
  "type": "object",
  "required": ["id", "name", "country", "dept_url", "status"],
  "properties": {
    "id":        { "type": "string", "description": "Slug, e.g. 'tum'" },
    "name":      { "type": "string" },
    "country":   { "type": "string", "description": "ISO 3166-1 alpha-2 country code, e.g. 'DE'" },
    "dept_url":  { "type": "string", "format": "uri", "description": "URL of the relevant department or faculty page" },
    "status":    { "type": "string", "enum": ["pending", "in_progress", "needs_review", "approved", "flagged", "interrupted"] },
    "notes":     { "type": "string", "default": "" },
    "last_run":  { "type": ["string", "null"], "format": "date-time" },
    "run_count": { "type": "integer", "default": 0 }
  }
}
